# KSeF connection (see design/SPEC.md §3.1 and §3.5)
# One-time setup: generate a KSeF Token scoped to InvoiceRead only, via the official
# KSeF Taxpayer App / e-Urząd Skarbowy, then paste it here. Treat as a secret.
KSEF_TOKEN=
# NIP of the company/context to authenticate as (Parkowa's NIP).
KSEF_NIP=
# One of: TEST, DEMO, PRD. Use TEST while developing.
KSEF_ENVIRONMENT=TEST

# Optional proxy for KSeF network traffic. ksef-client reads these standard
# uppercase names; lowercase https_proxy/http_proxy are not supported.
# HTTPS_PROXY=http://proxy.example.com:912
# HTTP_PROXY=http://proxy.example.com:912
# NO_PROXY=localhost,127.0.0.1

# Path to the SQLite database file (created automatically if missing).
DATABASE_PATH=./data/ksef-exporter.sqlite

# API auth (see design/SPEC.md §2.2.4). Single-owner login, no user
# management. Treat both as secrets.
AUTH_USERNAME=
AUTH_PASSWORD=
# Random string (32+ chars) used to sign session JWTs, e.g. `openssl rand -base64 32`.
JWT_SECRET=

# Port the API server listens on.
PORT=3000
# Origin the frontend is served from (allow-listed for CORS).
WEB_ORIGIN=http://localhost:5173

# Log verbosity: fatal, error, warn, info, debug, trace, or silent.
# "info" (default) includes sync/import progress (fetching from KSeF,
# invoice counts, persisting, errors) -- set to "silent" only if you truly
# want no server logs.
LOG_LEVEL=info
