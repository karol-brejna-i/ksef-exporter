{
  "name": "ksef-exporter",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted app that pulls purchase invoices from KSeF, categorizes them, and supports manual correction.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit false --outDir dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "smoke:ksef": "tsx src/ksef/smoke.ts",
    "smoke:invoices": "tsx src/ksef/smoke-invoices.ts",
    "dump:invoices": "tsx src/ksef/dump-invoices.ts",
    "extract:xlsx": "tsx src/tools/extract-xlsx.ts",
    "reconcile": "tsx src/tools/reconcile.ts",
    "backfill:items": "tsx src/tools/backfill-invoice-items.ts",
    "dev:api": "tsx watch src/api/main.ts",
    "start:api": "tsx src/api/main.ts",
    "db:generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.13.3",
    "drizzle-kit": "^0.31.10",
    "tsx": "4.23.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4",
    "xlsx": "^0.18.5"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.0",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.9.3",
    "fastify": "^5.10.0",
    "ksef-client": "^0.7.1",
    "zod": "^3.24.1"
  }
}
