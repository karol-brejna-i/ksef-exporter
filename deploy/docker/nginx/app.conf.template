# Rendered by the official nginx entrypoint (envsubst over
# /etc/nginx/templates/*.template -> /etc/nginx/conf.d/*.conf) at container
# start. The API_UPSTREAM environment variable is the ONLY thing meant to be
# substituted below — it is the sole name written with a dollar-brace form.
# Every nginx variable (its own request/proxy variables, not container env
# vars) is written as a bare dollar-name so envsubst's restricted,
# env-derived variable list leaves it untouched. Never wrap an nginx
# variable in dollar-braces.
#
# (This comment intentionally avoids writing out either form literally:
# envsubst does not respect "#" comments, so a literal example here would
# get rewritten too when the entrypoint renders this file.)

server {
    listen 80;
    server_name _;

    client_max_body_size 1m;

    gzip on;
    gzip_vary on;
    gzip_types text/plain text/css text/javascript application/javascript application/json;

    root /usr/share/nginx/html;
    index index.html;

    # Trailing slash on proxy_pass strips the /api prefix before forwarding,
    # mirroring the Vite dev proxy's rewrite: /api/auth/login on the wire
    # reaches the backend's /auth/login. proxy_read_timeout is raised well
    # past the 60s default because POST /sync polls a KSeF export and
    # GET /invoices/export streams a generated workbook; both can run long.
    location /api/ {
        proxy_pass ${API_UPSTREAM}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }

    # Vite emits content-hashed filenames under /assets/, so these can be
    # cached forever; index.html references the current hashes and must
    # never be served stale.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location = /index.html {
        add_header Cache-Control "no-store";
    }

    # SPA fallback: any path not matched above (and not an existing static
    # file) is served index.html so client-side routing can take over.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
