# Committed, non-secret stack configuration for local smoke testing only.
# Consumed by `deploy/ksef-stack.sh local ...` as the Compose --env-file.
# Do not add secrets here — see local.secrets.env.example for those.
#
# BACKUP_DIR is a relative bind path (resolved against this compose file's
# directory, i.e. `deploy/`) rather than an absolute host path like the real
# tenants use, so a throwaway local stack needs no host directory to exist
# beforehand outside the checkout. Compose accepts `./`-relative bind mounts
# and creates the directory on first `up` if missing.
COMPOSE_PROJECT_NAME=ksef-local
TENANT=local
KSEF_ENVIRONMENT=TEST
WEB_ORIGIN=http://localhost:8091
WEB_BIND=127.0.0.1
WEB_PORT=8091
LOG_LEVEL=info
TZ=Europe/Warsaw
BACKUP_DIR=./tmp/backups-local
