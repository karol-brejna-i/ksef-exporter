# Template for the git-ignored deploy/env/portowa.secrets.env.
# Copy this file to `portowa.secrets.env` (no `.example` suffix) next to it and
# fill in real values on the host. Never commit the copy — it is matched by the
# `*.env` pattern in .gitignore.

# 10-digit NIP of the tenant's KSeF context, e.g. 5265877635. Digits only,
# no spaces or dashes (src/config/env.ts strips those but the value must
# still reduce to exactly 10 digits).
KSEF_NIP=

# Long-lived KSeF token, scoped to InvoiceRead only. Treat as a secret.
KSEF_TOKEN=

# Single-owner login username for the web UI. Any non-empty string.
AUTH_USERNAME=

# Single-owner login password for the web UI. Minimum 8 characters
# (src/config/env.ts: AUTH_PASSWORD must be at least 8 characters).
AUTH_PASSWORD=

# Secret used to sign/verify session JWTs. Minimum 32 characters
# (src/config/env.ts: JWT_SECRET must be at least 32 characters).
# Generate one with: openssl rand -base64 32
JWT_SECRET=
