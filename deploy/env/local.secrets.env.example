# Template for the git-ignored deploy/env/local.secrets.env, used only for a
# throwaway local smoke stack (`deploy/ksef-stack.sh local ...`). Copy this
# file to `local.secrets.env` (no `.example` suffix) next to it.
#
# The values below are obviously-fake but schema-valid placeholders (they
# satisfy every check in src/config/env.ts) so a developer can copy this file
# verbatim and boot a stack with no real KSeF access. This stack must still
# point at a throwaway database/volume, never at real credentials, a real
# KSEF_TOKEN, or a real tenant database — the local stack has no KSeF
# connectivity anyway, since nothing here triggers a sync automatically.

# 10-digit NIP. Fake but schema-valid (10 digits).
KSEF_NIP=0000000000

# Fake KSeF token placeholder. Login-only smoke testing never calls KSeF, so
# this value is never actually used for a real request.
KSEF_TOKEN=local-smoke-test-placeholder-token

# Single-owner login username for the web UI.
AUTH_USERNAME=local-dev

# Single-owner login password for the web UI. Minimum 8 characters.
AUTH_PASSWORD=local-dev-password

# Secret used to sign/verify session JWTs. Minimum 32 characters.
# This placeholder is exactly 32 characters; generate a real one for anything
# beyond a throwaway local stack with: openssl rand -base64 32
JWT_SECRET=local-dev-jwt-secret-32-chars-ok
