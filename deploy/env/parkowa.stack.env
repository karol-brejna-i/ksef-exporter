# Committed, non-secret stack configuration for tenant "parkowa".
# Consumed by `deploy/ksef-stack.sh parkowa ...` as the Compose --env-file.
# Do not add secrets here — see parkowa.secrets.env.example for those.
COMPOSE_PROJECT_NAME=ksef-parkowa
TENANT=parkowa
KSEF_ENVIRONMENT=PRD
WEB_ORIGIN=https://parkowa.zagwozdki.ovh
WEB_BIND=192.168.0.102
WEB_PORT=8081
LOG_LEVEL=info
TZ=Europe/Warsaw
BACKUP_DIR=/srv/ksef-backups/parkowa
